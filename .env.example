# Copy to .env (git-ignored). Used by the CLI scripts only; the site build needs none of these.

# Cloudflare R2 (see the "ready for human" issue on R2 setup)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tim-birds-photos

# Public base URL that serves the bucket, no trailing slash.
# The r2.dev URL for now; img.<your-domain> once a domain is chosen.
PUBLIC_IMAGE_BASE=
