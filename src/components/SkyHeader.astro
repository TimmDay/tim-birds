---
// The dawn header. Adapted from coin-cabinet's dusk sky: the colour bands are
// rings of one huge circle centred far below the page, so the horizon curves
// like the edge of the earth. Here the order runs the other way, from night
// at the top to a thin band of first light behind a treeline.
import { SITE_NAME } from '../config.ts';

type Props = { size?: 'tall' | 'short'; current?: string };
const { size = 'short', current = '' } = Astro.props;

const nav = [
  { href: '/', label: 'Gallery' },
  { href: '/species/', label: 'Species' },
  { href: '/map/', label: 'Map' },
  { href: '/about/', label: 'About' },
  { href: '/data/', label: 'Data' },
];

// A deterministic treeline: rounded eucalypt-like crowns of varying height.
function treeline(width: number, height: number, seed: number): string {
  let s = seed;
  const rand = () => (s = (s * 16807) % 2147483647) / 2147483647;
  let d = `M0 ${height} L0 ${height * 0.7}`;
  let x = 0;
  while (x < width) {
    const w = 18 + rand() * 46;
    const h = height * (0.25 + rand() * 0.6);
    const top = height - h;
    d += ` Q${x + w * 0.1} ${top + h * 0.2} ${x + w * 0.5} ${top} Q${x + w * 0.9} ${top + h * 0.2} ${x + w} ${height * (0.55 + rand() * 0.3)}`;
    x += w;
  }
  return `${d} L${width} ${height} Z`;
}
const back = treeline(1600, 70, 7);
const front = treeline(1600, 46, 42);
---

<header class:list={['sky', size]}>
  <div class="bar">
    <a class="name" href="/">
      {SITE_NAME}
    </a>
    <nav aria-label="Main">
      <ul>
        {nav.map((n) => (
          <li>
            <a
              href={n.href}
              aria-current={current === n.href ? 'page' : undefined}
            >
              {n.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <svg
    class="birds"
    aria-hidden="true"
    viewBox="0 0 120 30"
    preserveAspectRatio="xMidYMid meet"
  >
    <path d="M10 18 q4 -5 8 0 q4 -5 8 0" />
    <path d="M40 10 q3 -4 6 0 q3 -4 6 0" />
    <path d="M58 16 q2.5 -3 5 0 q2.5 -3 5 0" />
  </svg>
  <svg
    class="trees"
    aria-hidden="true"
    viewBox="0 0 1600 70"
    preserveAspectRatio="none"
  >
    <path class="back" d={back} />
    <path class="front" d={front} transform="translate(0 24)" />
  </svg>
</header>

<style>
  .sky {
    --nav-h: 112px;
    --sag: 1.6vw;
    --earth-r: 780vw;
    position: relative;
    isolation: isolate;
    min-height: var(--nav-h);
    margin-bottom: var(--space-6);
    overflow: hidden;
  }
  .sky.tall {
    --nav-h: 195px;
  }
  @media (min-width: 1024px) {
    .sky {
      --nav-h: 135px;
    }
    .sky.tall {
      --nav-h: 240px;
    }
  }

  .sky::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    background: radial-gradient(
      circle at 50% calc(100% - var(--sag) + var(--earth-r)),
      var(--color-sky-horizon) var(--earth-r),
      var(--color-sky-glow) calc(var(--earth-r) + var(--nav-h) * 0.06),
      var(--color-sky-rose) calc(var(--earth-r) + var(--nav-h) * 0.16),
      var(--color-sky-low) calc(var(--earth-r) + var(--nav-h) * 0.3),
      var(--color-sky-mid) calc(var(--earth-r) + var(--nav-h) * 0.5),
      var(--color-sky-high) calc(var(--earth-r) + var(--nav-h) * 0.75),
      var(--color-sky-top) calc(var(--earth-r) + var(--nav-h))
    );
  }

  .bar {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--space-4) var(--gutter);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
  }

  .name {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: none;
    letter-spacing: 0.04em;
  }

  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
  }
  nav a {
    color: var(--color-ink-muted);
    text-decoration: none;
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: var(--space-1) 0;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--color-gold);
  }

  .birds {
    position: absolute;
    right: 12%;
    bottom: 34%;
    width: clamp(70px, 9vw, 120px);
    fill: none;
    stroke: var(--color-treeline);
    stroke-width: 1.4;
    stroke-linecap: round;
    opacity: 0.8;
  }

  .trees {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 56px;
    z-index: -1;
  }
  .trees .back {
    fill: color-mix(in srgb, var(--color-treeline) 80%, var(--color-sky-low));
  }
  /* The front row is the page colour, so the treeline melts into the page. */
  .trees .front {
    fill: var(--color-surface);
  }
</style>
