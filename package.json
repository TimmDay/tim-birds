{
  "name": "tim-birds",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "if [ \"$DEMO\" = \"true\" ]; then node scripts/make-demo.ts; fi",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "astro check",
    "check": "pnpm lint && pnpm typecheck",
    "format": "prettier --write .",
    "test": "vitest",
    "test:run": "vitest run --passWithNoTests",
    "prepare": "husky",
    "demo": "node scripts/make-demo.ts && DEMO=true astro dev",
    "import-ebird": "node scripts/import-ebird.ts",
    "add-photo": "node scripts/add-photo.ts",
    "best-photo": "node scripts/best-photo.ts",
    "sync-photos": "node scripts/sync-photos.ts",
    "mark-sensitive": "node scripts/mark-sensitive.ts"
  },
  "lint-staged": {
    "*.{ts,js,mjs,astro,svelte}": [
      "eslint --max-warnings 0",
      "prettier --write"
    ],
    "*.{md,json,css,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.1.2",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@lucide/astro": "^1.70.0",
    "astro": "^7.4.7",
    "csv-parse": "^7.0.3",
    "sharp": "^0.35.5",
    "svelte": "^5.57.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@aws-sdk/client-s3": "^3.1164.0",
    "@eslint/js": "^10.0.1",
    "@inquirer/prompts": "^8.7.5",
    "dotenv": "^18.0.9",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-svelte": "^3.24.1",
    "exifr": "^7.1.3",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
