{
  "name": "tim-birds",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "astro check",
    "check": "pnpm lint && pnpm typecheck",
    "format": "prettier --write .",
    "test": "vitest",
    "test:run": "vitest run --passWithNoTests",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,mjs,astro,svelte}": [
      "eslint --max-warnings 0",
      "prettier --write"
    ],
    "*.{md,json,css,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.1.2",
    "astro": "^7.4.7",
    "sharp": "^0.35.5",
    "svelte": "^5.57.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
